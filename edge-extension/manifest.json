{
  "manifest_version": 3,
  "name": "DevSpace Auto Start for ChatGPT",
  "version": "1.0.0",
  "description": "Starts DevspaceNgrokFoot when the configured ChatGPT project or Temporary Chat is opened.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
